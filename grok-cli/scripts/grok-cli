#!/usr/bin/env node
/*
 * grok-cli — 个人使用的 Grok 生图命令行工具（仅本机可用）。
 * 零外部依赖，仅用 Node 内置能力。配置在 config.json（含 API Key）。
 *
 * 用法：
 *   grok-cli "一只雪地里的红狐狸"
 *   grok-cli image "描述" [--model image|quality|lite|2.0] [--size 1024x1024] [--count n] [--out 目录]
 *     描述也可以直接作为第一个参数（不带 image 子命令）。
 */
"use strict";

const fs = require("fs");
const path = require("path");

const CONFIG_PATH = path.join(__dirname, "config.json");

function loadConfig() {
  try {
    return JSON.parse(fs.readFileSync(CONFIG_PATH, "utf8"));
  } catch (e) {
    console.error(`无法读取配置 ${CONFIG_PATH}: ${e.message}`);
    process.exit(1);
  }
}
const cfg = loadConfig();
const BASE = cfg.baseUrl.replace(/\/+$/, "");
const KEY = cfg.apiKey;

const DEFAULT_OUT_DIR = path.join(process.cwd(), "grok-output");

function outDir() {
  const dir = process.env.GROK_OUT_DIR || DEFAULT_OUT_DIR;
  fs.mkdirSync(dir, { recursive: true });
  return dir;
}

function ts() {
  const d = new Date();
  const p = (n) => String(n).padStart(2, "0");
  return `${d.getFullYear()}${p(d.getMonth() + 1)}${p(d.getDate())}_${p(d.getHours())}${p(d.getMinutes())}${p(d.getSeconds())}`;
}

function sanitize(s) {
  return s.replace(/[\\/:*?"<>|\s]+/g, "_").slice(0, 60) || "out";
}

async function generate(body, attempt = 1) {
  const res = await fetch(`${BASE}/v1/images/generations`, {
    method: "POST",
    headers: {
      Authorization: `Bearer ${KEY}`,
      "Content-Type": "application/json",
      "User-Agent": "grok-cli/1.0",
      Accept: "application/json",
    },
    body: JSON.stringify(body),
    signal: AbortSignal.timeout(300000),
  });
  const text = await res.text();
  let data;
  try { data = JSON.parse(text); } catch { data = text; }
  if (!res.ok) {
    const msg = data && (data.error?.message || data.message) || text.slice(0, 300);
    // 上游超时（524）或瞬断时自动重试一次
    if ((res.status === 524 || res.status >= 500) && attempt < 2) {
      console.error(`[上游${res.status}，2 秒后重试…]`);
      await new Promise((r) => setTimeout(r, 2000));
      return generate(body, attempt + 1);
    }
    throw new Error(`HTTP ${res.status}: ${msg}`);
  }
  return data;
}

async function download(url, savePath) {
  const res = await fetch(url, { signal: AbortSignal.timeout(120000) });
  if (!res.ok) {
    const loc = res.headers.get("location");
    if (loc && [301, 302, 303, 307, 308].includes(res.status)) return download(loc, savePath);
    throw new Error(`下载失败 HTTP ${res.status}: ${url}`);
  }
  fs.writeFileSync(savePath, Buffer.from(await res.arrayBuffer()));
  return savePath;
}

const EXT = { "image/jpeg": "jpg", "image/png": "png", "image/webp": "webp", "image/gif": "gif" };

async function main() {
  const args = process.argv.slice(2);
  const opts = { model: cfg.defaultImageModel, size: null, count: 1, out: null, json: false };
  const positional = [];
  for (let i = 0; i < args.length; i++) {
    const a = args[i];
    if (a === "--model") opts.model = args[++i];
    else if (a === "--size") opts.size = args[++i];
    else if (a === "--count") opts.count = parseInt(args[++i], 10) || 1;
    else if (a === "--out") opts.out = args[++i];
    else if (a === "--json") opts.json = true;
    else if (a === "--help" || a === "-h") { console.log(USAGE); process.exit(0); }
    else positional.push(a);
  }
  // 兼容 "grok-cli image <描述>"：跳过 image 子命令
  if (positional[0] === "image") positional.shift();

  const prompt = positional.join(" ").trim();
  if (!prompt) {
    console.error(USAGE.trim());
    process.exit(1);
  }

  // 模型名可以是别名（image/quality/lite/2.0）也可以是完整模型 id
  const model = cfg.imageModels[opts.model] || (opts.model.startsWith("grok-") ? opts.model : cfg.defaultImageModel);

  const body = { model, prompt, n: opts.count };
  if (opts.size) body.size = opts.size;

  try {
    const data = await generate(body);
    if (opts.json) { console.log(JSON.stringify(data, null, 2)); return; }
    for (const [i, item] of (data.data || []).entries()) {
      const url = item.url;
      const mime = item.mime_type;
      if (item.b64_json) {
        const f = path.join(opts.out || outDir(), `${sanitize(prompt)}_${ts()}_${i + 1}.${EXT[mime] || "png"}`);
        fs.writeFileSync(f, Buffer.from(item.b64_json, "base64"));
        console.log(`图${i + 1} 已保存: ${f}`);
      } else if (url) {
        const ext = EXT[item.mime_type] || (path.extname(url.split("?")[0]).slice(1) || "jpg");
        const f = path.join(opts.out || outDir(), `${sanitize(prompt)}_${ts()}_${i + 1}.${ext}`);
        await download(url, f);
        console.log(`图${i + 1} 已保存: ${f}`);
      } else {
        console.log(`[图${i + 1} 无有效地址]`);
      }
    }
    if (data.revised_prompt) console.error(`[优化后提示词] ${data.revised_prompt}`);
  } catch (e) {
    console.error(`生图失败: ${e.message}`);
    process.exit(1);
  }
}

const USAGE = `grok-cli — Grok 文生图（个人配置）

用法:
  grok-cli "一只雪地里的红狐狸"
  grok-cli image "描述" [选项]

选项:
  --model image|quality|lite|2.0   图片模型（默认 image）
  --size 1024x1024                尺寸
  --count n                       一次生成 n 张
  --out <目录>                    输出目录（默认 ./grok-output/，也可用 GROK_OUT_DIR 覆盖）
  --json                          输出完整 JSON

示例:
  grok-cli "一只雪地里的红狐狸，数字艺术"
  grok-cli "赛博朋克城市夜景" --model quality --size 1024x1024 --count 2
`;

main();
